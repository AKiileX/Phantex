# Phantex — Production Environment Variables
#
# Copy this file and fill in real values:
#   cp .env.production.example .env.production
#
# Then launch with:
#   docker compose -f docker-compose.dev.yml -f docker-compose.prod.yml --env-file .env.production up -d
#
# ⚠️  NEVER commit .env.production to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
PHANTEX_ENVIRONMENT=production
PHANTEX_DEBUG=false

# ── Secrets (REQUIRED — must not be dev defaults) ─────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PHANTEX_JWT_SECRET=CHANGE_ME_generate_a_64_char_random_string
POSTGRES_PASSWORD=CHANGE_ME_strong_db_admin_password
PHANTEX_DB_PASSWORD=CHANGE_ME_strong_db_app_password
PHANTEX_DB_ADMIN_PASSWORD=CHANGE_ME_strong_db_admin_password
CLICKHOUSE_PASSWORD=CHANGE_ME_strong_clickhouse_password
NEO4J_PASSWORD=CHANGE_ME_strong_neo4j_password
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
PHANTEX_INTERNAL_TOKEN=CHANGE_ME_strong_gateway_token

# ── JWT Asymmetric Signing (REQUIRED in production) ──────────────────────────
# Generate keys:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Mount the keys into the container and reference them here:
PHANTEX_JWT_ALGORITHM=RS256
PHANTEX_JWT_PRIVATE_KEY_FILE=/etc/phantex/keys/jwt-private.pem
PHANTEX_JWT_PUBLIC_KEY_FILE=/etc/phantex/keys/jwt-public.pem

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=phantex
POSTGRES_USER=phantex_admin
PHANTEX_DB_SSL_MODE=require

# ── Network / CORS ────────────────────────────────────────────────────────────
# Set to the URL users access the dashboard at (no trailing slash)
PHANTEX_DASHBOARD_URL=https://phantex.example.com
PHANTEX_CORS_ORIGINS=["https://phantex.example.com"]
# For on-prem / lab / single-box deployments where localhost IS the real URL:
# PHANTEX_DASHBOARD_URL=http://localhost:3000
# PHANTEX_CORS_ORIGINS=["http://localhost:3000"]
# PHANTEX_ALLOW_LOCALHOST_CORS=true
# ── Redis ─────────────────────────────────────────────────────────────────────
# Password is injected below via compose override
PHANTEX_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── WebSocket ─────────────────────────────────────────────────────────────────
PHANTEX_WS_LEGACY_TOKEN_ENABLED=false

# ── Copilot LLM (optional) ───────────────────────────────────────────────────
COPILOT_PROVIDER=local
COPILOT_LOCAL_URL=http://host.docker.internal:1234/v1
COPILOT_LOCAL_MODEL=mistral
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Vault (optional — enable for Transit JWT signing + secret management) ────
# PHANTEX_VAULT_ENABLED=true
# PHANTEX_VAULT_ADDR=http://vault:8200
# PHANTEX_VAULT_ROLE_ID=CHANGE_ME
# PHANTEX_VAULT_SECRET_ID=CHANGE_ME

# ── Gateway gRPC TLS (REQUIRED in production) ────────────────────────────────
# Generate certs or use your CA. Mount into gateway container.
# Configure in gateway/gateway.yaml under grpc.tls_enabled, tls_cert_file, etc.
GATEWAY_TLS_CERTS_DIR=./infra/tls

# ── Kafka TLS/SASL (optional — enable for encrypted Kafka) ──────────────────
# Set KAFKA_SECURITY_PROTOCOL=SASL_SSL for encrypted Kafka traffic.
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SSL_KEYSTORE_LOCATION=/etc/kafka/tls/kafka.keystore.jks
# KAFKA_SSL_KEYSTORE_PASSWORD=CHANGE_ME
# KAFKA_SSL_TRUSTSTORE_LOCATION=/etc/kafka/tls/kafka.truststore.jks
# KAFKA_SSL_TRUSTSTORE_PASSWORD=CHANGE_ME
# KAFKA_TLS_CERTS_DIR=./infra/tls

# ── Ports (change if needed) ─────────────────────────────────────────────────
BACKEND_PORT=8000
DASHBOARD_PORT=443
GATEWAY_PORT=50051
