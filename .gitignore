# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Go ──────────────────────────────────────────────────────────────────────
sensor/phantex-sensor
gateway/phantex-gateway
gateway/phantex-consumer
gateway/phantex-test-sender
*.exe
# NOTE: vendor/ is NOT ignored — it is committed for hermetic builds (ADR-014)
# Run `go mod vendor` to populate, `go mod verify` to validate integrity

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.out

# ─── Node / Dashboard ───────────────────────────────────────────────────────
node_modules/
dashboard/dist/
dashboard/build/
.next/
.turbo/

# ─── eBPF build artifacts ───────────────────────────────────────────────────
*.o
!sensor/ebpf/**/*.bpf.c
vmlinux.h
# Compiled probes and signatures are built per-deployment (not committed)
sensor/internal/ebpf/bpf/*.bpf.o
sensor/internal/ebpf/bpf/*.bpf.o.sig

# ─── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Secrets / Environment ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example
login.json
gateway/gateway.yaml
gateway/gateway-test.yaml
!gateway/gateway.yaml.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
secrets/
*.secret
**/.env.local

# ─── eBPF Signing Keys (generated per-deployment — never committed) ─────────
sensor/keys/ebpf-sign.seed
sensor/keys/ebpf-sign.pub

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Terraform / Infra ──────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# ─── Protobuf generated code (regenerated from proto/) ──────────────────────
