# PhanTeX — Environment Variables (Development)
#
# Copy to .env and adjust:  cp .env.example .env
# NEVER commit .env to Git — it contains secrets.
#
# Variables marked 🔒 MUST be changed for production.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=phantex
POSTGRES_USER=phantex_admin
POSTGRES_PASSWORD=phantex-dev-password          # 🔒
POSTGRES_PORT=5432

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_DB=phantex
CLICKHOUSE_USER=phantex
CLICKHOUSE_PASSWORD=phantex-dev-password         # 🔒
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=phantex-dev-password              # 🔒
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Backend API ───────────────────────────────────────────────────────────────
PHANTEX_ENVIRONMENT=development
PHANTEX_DEBUG=true
BACKEND_PORT=8000
PHANTEX_DB_HOST=localhost
PHANTEX_DB_PORT=5432
PHANTEX_DB_NAME=phantex
PHANTEX_DB_USER=phantex_app
PHANTEX_DB_PASSWORD=phantex-app-dev-password      # 🔒
PHANTEX_DB_ADMIN_USER=phantex_admin
PHANTEX_DB_ADMIN_PASSWORD=phantex-dev-password    # 🔒
PHANTEX_JWT_SECRET=phantex-dev-jwt-secret-change-in-production  # 🔒
PHANTEX_JWT_ALGORITHM=HS256
PHANTEX_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
PHANTEX_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PHANTEX_CORS_ORIGINS=["http://localhost:3000"]
PHANTEX_INTERNAL_TOKEN=phantex-dev-internal-token   # 🔒 CHANGE for production

# ── Kafka (Backend) ──────────────────────────────────────────────────────────
PHANTEX_KAFKA_BOOTSTRAP=localhost:9092
PHANTEX_KAFKA_TLS_ENABLED=false
# PHANTEX_KAFKA_TLS_CERT_FILE=
# PHANTEX_KAFKA_TLS_KEY_FILE=
# PHANTEX_KAFKA_TLS_CA_FILE=

# ── Redis (Backend) ──────────────────────────────────────────────────────────
PHANTEX_REDIS_URL=redis://localhost:6379/0
PHANTEX_REDIS_TLS_ENABLED=false

# ── ClickHouse (Backend) ─────────────────────────────────────────────────────
# Leave PHANTEX_CLICKHOUSE_HOST empty to disable ClickHouse
PHANTEX_CLICKHOUSE_HOST=
PHANTEX_CLICKHOUSE_PORT=8123
PHANTEX_CLICKHOUSE_DATABASE=phantex
PHANTEX_CLICKHOUSE_USER=phantex
PHANTEX_CLICKHOUSE_PASSWORD=phantex-dev-password  # 🔒
PHANTEX_CLICKHOUSE_TLS_ENABLED=false

# ── Neo4j (Backend) ──────────────────────────────────────────────────────────
# Leave PHANTEX_NEO4J_URI empty to disable Neo4j
PHANTEX_NEO4J_URI=
PHANTEX_NEO4J_USER=neo4j
PHANTEX_NEO4J_PASSWORD=phantex-dev-password       # 🔒
PHANTEX_NEO4J_DATABASE=neo4j
PHANTEX_NEO4J_TLS_ENABLED=false

# ── Vault ─────────────────────────────────────────────────────────────────────
PHANTEX_VAULT_ENABLED=false
PHANTEX_VAULT_ADDR=http://127.0.0.1:8200
# PHANTEX_VAULT_TOKEN=                            # 🔒
# PHANTEX_VAULT_ROLE_ID=                          # 🔒
# PHANTEX_VAULT_SECRET_ID=                        # 🔒

# ── TLS (Database connections) ────────────────────────────────────────────────
PHANTEX_DB_SSL_MODE=disable
# PHANTEX_DB_SSL_CERT_FILE=
# PHANTEX_DB_SSL_KEY_FILE=
# PHANTEX_DB_SSL_CA_FILE=

# ── Copilot / LLM ────────────────────────────────────────────────────────────
COPILOT_PROVIDER=local
COPILOT_LOCAL_URL=http://host.docker.internal:1234/v1
COPILOT_LOCAL_MODEL=mistral
COPILOT_MAX_TOKENS=4096
COPILOT_TEMPERATURE=0.3
# OPENAI_API_KEY=                                 # 🔒
# ANTHROPIC_API_KEY=                              # 🔒

# ── Gateway (Go / gRPC) ──────────────────────────────────────────────────────
GATEWAY_PORT=50051

# ── Trust Engine (Rust) ──────────────────────────────────────────────────────
TRUST_ENGINE_PORT=50052
TRUST_ENGINE_GRPC_ADDR=0.0.0.0:50052
RUST_LOG=info

# ── ML Pipeline ──────────────────────────────────────────────────────────────
PHANTEX_ML_DEV_MODE=true
PHANTEX_SIGNING_KEY=local-dev-key                # 🔒
PHANTEX_TELEMETRY_EXPORT=true

# ── Deception ─────────────────────────────────────────────────────────────────
PHANTEX_DECOY_KEY_PASSPHRASE=phantex-decoy-key   # 🔒

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── SDK ───────────────────────────────────────────────────────────────────────
# PHANTEX_TOKEN=                                  # 🔒
# PHANTEX_TENANT_ID=
# PHANTEX_AGENT_ID=
# PHANTEX_GATEWAY_ADDR=localhost:50051
